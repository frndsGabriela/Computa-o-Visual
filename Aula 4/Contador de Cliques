<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Contador de Cliques no Canvas</title>
<style>
  body { font-family: sans-serif; text-align: center; background: #222; color: #eee; }
  canvas { background: #fff; border: 2px solid #555; margin-top: 10px; cursor: pointer; }
  button { padding: 8px 16px; font-size: 16px; margin-top: 10px; cursor: pointer; }
</style>
</head>
<body>
  <h2>Contador de Cliques</h2>
  <button id="btnClique">Clique Aqui</button><br>
  <canvas id="canvas" width="400" height="400"></canvas>

<script>
  const canvas = document.getElementById("canvas");
  const ctx = canvas.getContext("2d");
  const btn = document.getElementById("btnClique");

  let contador = 0;

  function desenharTexto(texto) {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.font = "20px Arial";
    ctx.fillStyle = "black";
    ctx.textAlign = "center";
    ctx.fillText(texto, canvas.width / 2, canvas.height / 2);
  }

  btn.addEventListener("click", () => {
    contador++;
    desenharTexto(`Você clicou ${contador} vezes.`);
  });

  desenharTexto("Clique no botão acima!");
</script>
</body>
</html>
